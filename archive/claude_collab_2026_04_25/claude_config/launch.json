{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flow-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "8091", "--app-dir", "backend", "--log-level", "warning"],
      "port": 8091
