GOOGLE_CLOUD_PROJECT=project-a74ca951-f06d-477a-816
GOOGLE_CLOUD_LOCATION=us-central1
# Opt in to building the Vertex/Gemini LLM endpoint from GOOGLE_CLOUD_PROJECT
# above (the admin LLM api_url is left blank). Verified working via gcloud ADC.
# Remove this line to disable the LLM; the home agent then fails fast with a
# clear "not connected" message instead of hanging.
FLOW_LLM_ENABLE_ENV_FALLBACK=1